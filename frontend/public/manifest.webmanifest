{
  "name": "Veya",
  "short_name": "Veya",
  "description": "Private, real-time messaging",
  "id": "/",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "theme_color": "#128c7e",
  "background_color": "#efeae2",
  "lang": "en",
  "dir": "ltr",
  "categories": ["social", "communication"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/veya-logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/veya-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open messages",
      "short_name": "Messages",
      "url": "/home",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Open settings",
      "short_name": "Settings",
      "url": "/settings",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ]
}
